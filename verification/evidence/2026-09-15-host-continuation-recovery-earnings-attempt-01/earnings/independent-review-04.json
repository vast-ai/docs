  "substantive_findings": [
    {
      "topic": "Summary cards",
      "finding": "Hn/Er support account/data-conditioned cards and rental component aggregation. Nine corrections remove unsupported balance settlement/lifetime categories and accurately describe the visible cards without claiming loaded account data."
    },
    {
      "topic": "Payout history and exports",
      "finding": "La/Ba/$a and published payment sections support date filters, CSV/PDF controls and Invoice Date/ID/Paid Date/Service/Amount, with Pending fallback. Billing po/ro/pr/Ir/uo shows Export All opens CSV/PDF menu and invoice rows conditionally offer individual format downloads."
    },
    {
      "topic": "Settings and payout methods",
      "finding": "er/We/Xn explicitly implement one connected provider with disconnect-first guidance. Is/Ur renders invoice information conditionally and edits the selected account fields. This supports scoped control/navigation descriptions, not complete backend authorization or a completed mutation."
    },
    {
      "topic": "Five residuals",
      "finding": "Frontend selected-currentUser rendering cannot establish Host-team earnings allocation or payout permission policy. All five remain UV; prior four exact topic objects persist and the fifth joins the existing allocation topic with an explicit owner/source requirement."
    },
    {
      "topic": "Observed navigation",
      "finding": "NAV establishes only Account > Earnings sidebar label/route in an expired session, not loaded balances or access. TAX-LINK establishes repository route existence, not tax advice accuracy."
    }
  ],
