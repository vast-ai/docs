\" href=\"https://cdn.vast.ai/static/common.gen.css?c=1789098049\">\n    <link rel=\"stylesheet\" href=\"https://cdn.vast.ai/static/normalize.css?c=1789098049\">\n    <link rel=\"stylesheet\" href=\"https://cdn.vast.ai/static/style.css?c=1789098049\">\n    <link rel=\"stylesheet\" href=\"https://use.fontawesome.com/releases/v5.3.1/css/all.css\">\n    <link rel=\"stylesheet\" href=\"https://use.fontawesome.com/releases/v5.3.1/css/v4-shims.css\">\n\n    <script id=\"stripe-js\" src=\"https://js.stripe.com/v3/\" async></script>\n    <script src=\"https://js.crypto.com/sdk?publishable-key=pk_live_MViERgdsMWx82VFhjd21WCY2\"></script><title>GPU Hosting: the Easiest Way to Rent Out Your GPU | Vast.ai</title></head>\n  \n  <body class=\"home\">\n\n      <div id=\"react-takeover\">\n  <div id=\"wrapper\">\n      <header class=\"site-header\">\n          <div class=\"container\">\n            <div class=\"header-cols\">\n              <div class=\"logo\"><a href=\"/\"><img src=\"https://cdn.vast.ai/static/vast-logo.svg?c=1789098049\" alt=\"Logo\"></a></div>\n              <div class=\"menu\">\n                <ul>\n                  <li><a class=\"home\" href=\"/hosting\">Hosting</a></li>\n                  <li><a class=\"home\" href=\"/#pricing\">Pricing</a></li>\n                  <li><a class=\"home\" href=\"/faq\">FAQ</a></li>\n                  <li><a class=\"home\" href=\"https://docs.vast.ai/\" target=\"_blank\">Docs</a></li>\n                  <li><a class=\"home\" href=\"/careers\">Careers</a></li>\n                  <li><a class=\"home\" href=\"/#contact\">Contact</a></li>\n                </ul>\n              </div>\n              <div class=\"header-right-cta\">\n                <a href=\"/\">Console</a>\n                <div class=\"mobile-menu-trigger\"><span></span><span></span><span></span></div>\n              </div>\n            </div>\n          </div>\n        </header>\n      </div>\n    \n\t\t<div class=\"hosting-topsection\">\n\t\t\t<div class=\"mui-container\">\n\t\t\t\t<div class=\"mui-row\">\n\t\t\t\t\t<div class=\"mui-col-md-7 pitch-text\">\n\t\t\t\t\t\t<h1>Full Employment for GPUs</h1>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p class=\"pitch-body\">\n\t\t\t\t\t\tRent out your GPU to make your hobby pay for itself.\n\t\t\t\t\t\tTransform your mining farm into a GPU training center and earn ~2x to ~4x more per gpu-hour than mining cryptocurrency.\n\t\t\t\t\t\tWe connect you with customers and provide simple tools to streamline hosting.\n\t\t\t\t\t\tYou set your own prices and schedules.  Get started today.\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"mui-col-md-5\">\n\t\t\t\t\t\t<a href=\"/host/setup/\" class=\"mui-btn mui-btn--raised mui-btn--primary search-button\">\n\t\t\t\t\t\t\tStart Hosting\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\n\n\t\t\t\t</div>\n\t\t\t</div>\n      <div class=\"image-credit\">\n        Image &copy; <a href=\"https://arstechnica.com/civis/memberlist.php?mode=viewprofile&u=7247\" target=\"_blank\">WhiteGoblin</a>, used with permission &lt;3\n      </div>\n\n\t\t</div>\n\n\t\t<div class=\"mui-container\">\n\t\t\t<div class=\"mui-row blurb-section\">\n\n\t\t        <div class=\"mui-col-md-6\">\n\t\t          <h2>Automatic Management</h2>\n\t\t          <br>\n\t\t          <p class=\"mui--text-subhead\">\n\t\t          Vast automatically manages the complexities of hosting.\n\t\t          Our software analyzes your hardware, tests its performance, and suggests contract pricing based on current market conditions.\n\t\t          You can get started quickly with the suggested defaults or customize pricing and contractual terms to your heart’s content.\n\t\t          Our management layer automatically schedules resources to maximize profitability,\n\t\t          dynamically switching between jobs so that mining and other interruptible tasks run whenever higher paying contracts are unavailable.\n\t\t          Customers can rent out various combinations of GPUs and other resources on multi-GPU systems\n\t\t          while the remaining GPUs continue working on background tasks.\n\t\t          </p>\n\n\t\t        </div>\n\n\t\t        <div class=\"mui-col-md-1\">\n\t\t        </div>\n\n\t\t        <div class=\"mui-col-md-5\">\n\t\t          <h2>Flexible Pricing</h2>\n\t\t          <br>\n\n\t\t          <p class=\"mui--text-subhead\">\n\t\t          We understand that every host is different, and pretending otherwise is inefficient.\n\t\t          Have a monthly bandwidth cap?  You can charge for metered bandwidth.\n\t\t          Have cheap fiber internet? Then perhaps you want to offer simpler pricing plans with unlimited bandwidth.\n\t\t          We offer enough customization over combinations of GPU, CPU, storage and bandwidth billing to suit your needs.\n\t\t          As a Host, you can use recommend defaults or define your own pricing structure.\n\t\t          We provide the tools you need to become your own cloud provider.\n\t\t          </p>\n\t\t          <br><br>\n\n\t\t        </div>\n\t\t\t</div>\n\n\n\t\t\t<!-- i class=\"fa fa-university fa-5x mui- - text-display3 mui- -color-pink-A100 row wow zoomIn\" aria-hidden=\"true\"></i-->\n\t\t</div>\n\n\n      <footer class=\"site-footer\">\n          <div class=\"container\">\n            <div class=\"footer-upper\">\n              <div class=\"footer-logo\">\n                <a class=\"home\" href=\"index.html\"><img src=\"https://cdn.vast.ai/static/vast-logo.svg?c=1789098049\"></a>\n              </div>\n              <div class=\"footer-cols\">\n                <div class=\"footer-col\">\n                  <div class=\"footer-col-title\">Solutions</div>\n                  <ul>\n                    <li><a class=\"home\" href=\"/hosting\">Hosting</a></li>\n                    <li><a class=\"home\" href=\"/\">Console</a></li>\n                  </ul>\n                </div>\n                <div class=\"footer-col\">\n                  <div class=\"footer-col-title\">Resources</div>\n                